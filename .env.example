# Copy to a private .env; environment variables override this file.
U9_BASE_URL=https://erp.example.invalid/U9C
U9_CLIENT_ID=
U9_CLIENT_SECRET=
U9_ENT_CODE=
U9_ORG_CODE=
U9_USER_CODE=
# Set true only for the explicitly authorized HTTP environment.
U9_ALLOW_HTTP=false

# Required only for Streamable HTTP. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_ACCESS_TOKEN=
# Host header values, comma-separated. Add the deployed DNS name or IP with port.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,u9-mcp:8000,mcp.example.com
# Usually empty for native MCP clients. Add browser origins only when explicitly needed.
MCP_ALLOWED_ORIGINS=
MCP_MAX_REQUEST_BODY_SIZE=1048576
MCP_MAX_SESSIONS=64
MCP_SESSION_IDLE_TIMEOUT=300

# Human-operated browser console. The DashScope and MCP credentials stay on the server.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=deepseek-v4-flash-0731
# Generate separately from MCP_ACCESS_TOKEN.
CHAT_ACCESS_TOKEN=
CHAT_BIND_IP=127.0.0.1
CHAT_PORT=8001
